{
  "name": "movo",
  "version": "0.1.0",
  "private": true,
  "description": "Local media workspace",
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others --names api,web \"bun run dev:server\" \"bun run dev:web\"",
    "dev:server": "node --env-file-if-exists=.env --watch src/server/main.ts",
    "dev:web": "vite",
    "routes:generate": "tsr generate",
    "typecheck": "bun run routes:generate && tsc -p tsconfig.web.json && tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.tooling.json",
    "build": "bun run routes:generate && tsc -p tsconfig.server.json && vite build",
    "start": "NODE_ENV=production node --env-file-if-exists=.env dist/server/server/main.js",
    "lint": "node tooling/lint/run.ts",
    "lint:fix": "node tooling/lint/run.ts --fix",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:tools:real": "vitest run --config vitest.real.config.ts tests/real/media-tools.test.ts",
    "test:downloads:real": "vitest run --config vitest.real.config.ts tests/real/downloads.test.ts",
    "test:models:real": "vitest run --config vitest.real.config.ts tests/real/models.test.ts",
    "test:transcriptions:real": "vitest run --config vitest.real.config.ts tests/real/transcriptions.test.ts",
    "test:ask:real": "vitest run --config vitest.real.config.ts tests/real/ask.test.ts",
    "test:e2e": "node tooling/test-e2e.ts",
    "test:e2e:install": "playwright install chromium",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test && bun run build",
    "precommit": "lint-staged && bun run typecheck && bun run test",
    "prepare": "husky",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "audit": "bun audit",
    "audit:runtime": "bun audit --production"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.99",
    "@ai-sdk/openai": "4.0.111",
    "@ai-sdk/openai-compatible": "3.0.87",
    "@base-ui/react": "1.9.0",
    "@effect/platform-node": "4.1.2",
    "@fontsource-variable/inter": "5.3.0",
    "@hono/node-server": "2.1.6",
    "@hono/standard-validator": "0.4.1",
    "@hugeicons/core-free-icons": "4.4.0",
    "@hugeicons/react": "1.1.10",
    "@huggingface/gguf": "0.4.6",
    "@openrouter/ai-sdk-provider": "3.1.0",
    "@tanstack/react-query": "5.105.3",
    "@tanstack/react-router": "1.170.46",
    "ai": "7.0.166",
    "better-sqlite3": "13.0.3",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.2",
    "drizzle-orm": "0.45.4",
    "effect": "4.1.2",
    "hono": "4.13.16",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "transcribe-cpp": "0.4.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.4",
    "@tanstack/router-cli": "1.167.46",
    "@tanstack/router-plugin": "1.168.48",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "concurrently": "10.0.6",
    "drizzle-kit": "0.31.11",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "oxc-parser": "0.157.0",
    "oxfmt": "0.76.0",
    "oxlint": "1.91.0",
    "oxlint-tsgolint": "7.0.2005",
    "shadcn": "4.23.0",
    "tailwindcss": "4.3.4",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": ">=26.13.0 <27"
  }
}
