{
  "name": "movo",
  "version": "0.1.0",
  "private": true,
  "description": "Local media workspace",
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others --names api,web \"bun run dev:server\" \"bun run dev:web\"",
    "dev:server": "node --env-file-if-exists=.env --watch src/server/main.ts",
    "dev:web": "node node_modules/vite/bin/vite.js",
    "routes:generate": "node node_modules/@tanstack/router-cli/dist/esm/index.js generate",
    "typecheck": "bun run routes:generate && tsc -p tsconfig.web.json && tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.tooling.json",
    "build": "bun run routes:generate && tsc -p tsconfig.server.json && node node_modules/vite/bin/vite.js build",
    "start": "NODE_ENV=production node --env-file-if-exists=.env dist/server/server/main.js",
    "lint": "node tooling/lint/run.ts",
    "lint:fix": "node tooling/lint/run.ts --fix",
    "format": "node node_modules/oxfmt/bin/oxfmt --write .",
    "format:check": "node node_modules/oxfmt/bin/oxfmt --check .",
    "test": "node node_modules/vitest/vitest.mjs run",
    "test:watch": "node node_modules/vitest/vitest.mjs",
    "test:e2e": "node tooling/test-e2e.ts",
    "test:e2e:install": "node node_modules/@playwright/test/cli.js install chromium",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test && bun run build",
    "precommit": "node node_modules/lint-staged/bin/lint-staged.js && bun run typecheck && bun run test",
    "prepare": "node node_modules/husky/bin.js",
    "db:generate": "node node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "node node_modules/drizzle-kit/bin.cjs migrate",
    "audit": "bun audit",
    "audit:runtime": "bun audit --production"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@effect/platform-node": "4.1.2",
    "@fontsource-variable/inter": "5.3.0",
    "@hono/node-server": "2.1.6",
    "@hono/standard-validator": "0.4.1",
    "@hugeicons/core-free-icons": "4.4.0",
    "@hugeicons/react": "1.1.10",
    "@tanstack/react-query": "5.105.3",
    "@tanstack/react-router": "1.170.46",
    "better-sqlite3": "13.0.3",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.2",
    "drizzle-orm": "0.45.4",
    "effect": "4.1.2",
    "hono": "4.13.16",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.4",
    "@tanstack/router-cli": "1.167.46",
    "@tanstack/router-plugin": "1.168.48",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "concurrently": "10.0.6",
    "drizzle-kit": "0.31.11",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "oxc-parser": "0.157.0",
    "oxfmt": "0.76.0",
    "oxlint": "1.91.0",
    "oxlint-tsgolint": "7.0.2005",
    "shadcn": "4.23.0",
    "tailwindcss": "4.3.4",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  },
  "engines": {
    "bun": ">=1.4.4 <2",
    "node": ">=26.13.0 <27"
  },
  "packageManager": "bun@1.4.4"
}
